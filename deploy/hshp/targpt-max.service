[Unit]
Description=Follow the Frensy MAX bot (webhook)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=targpt
Group=targpt
WorkingDirectory=/opt/targpt
EnvironmentFile=/opt/targpt/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/targpt/venv/bin/python -m max_bot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
