TELEGRAM_TOKEN=ваш_токен_бота_из_BotFather
GROQ_API_KEY=ваш_groq_api_key

YOOKASSA_ACCOUNT_ID=ваш_shop_id_из_YooKassa
YOOKASSA_SECRET_KEY=ваш_secret_key_из_YooKassa

# Дополнительно, если будете использовать
YOOTOKEN=необязательно_если_не_нужен

# Groq используется для трактовок карт (OpenAI-совместимый API)
# Модель для трактовок (рекомендуется llama-3.3-70b-versatile)
GROQ_TAROT_MODEL=llama-3.3-70b-versatile

# Ссылки (по желанию)
CHANNEL_URL=https://t.me/follow_the_frensy
GROUP_INVITE_URL=https://t.me/+ваша_ссылка_на_группу
CONSULTATION_URL=https://t.me/roxanaametist
# MP4-ролик для приглашения на консультацию (положите файл в static/consultation.mp4)
CONSULTATION_VIDEO_PATH=static/consultation.mp4

# Секретная админ-команда (вместо /total_users123). Только для админов бота.
ADMIN_CMD_TOTAL_USERS=u9k2m7p4q1

# Данные бота на сервере (Amvera: /data). Локально можно не задавать.
# BOT_DATA_DIR=/data

# WebApp выбора карт (должны быть доступны по HTTPS)
CARDS_WEBAPP_URL=https://followthefrensy.ru/cards
YESNO_WEBAPP_URL=https://followthefrensy.ru/yesno

# Лендинг (папка landing/)
LANDING_BOT_URL=https://t.me/Roxanaametist_Taro_bot
LANDING_BOT_START_PARAM=site
BOT_RETURN_URL=https://t.me/Roxanaametist_Taro_bot
SOCIAL_TELEGRAM=https://t.me/follow_the_frensy
