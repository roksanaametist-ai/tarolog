TELEGRAM_TOKEN=ваш_токен_бота_из_BotFather

# --- MAX messenger bot (max_bot/) ---
# Тот же продукт, что Telegram-бот: меню, карты через запятую, +5 за друга, ЮKassa, промокоды.
# Токен из business.max.ru / «MAX для бизнеса»
MAX_BOT_TOKEN=
# Секрет webhook (5–256 символов: A-Za-z0-9_-) → заголовок X-Max-Bot-Api-Secret
MAX_WEBHOOK_SECRET=change_me_secret
# Публичный HTTPS endpoint (после nginx)
MAX_WEBHOOK_URL=https://followthefrensy.com/max/webhook
# Username бота без @ — для реф. ссылок https://max.ru/<username>?start=ref_<id>
MAX_BOT_USERNAME=
# MAX user id владельца (может отличаться от Telegram 491482483)
MAX_ADMIN_IDS=491482483
MAX_PORT=8088
# MAX_BOT_DATA_DIR=/root/tarolog/data_max
# MAX_API_BASE=https://platform-api2.max.ru
# Опционально: миниапп выбора карт (кнопка open_app)
# MAX_CARDS_MINIAPP_URL=https://followthefrensy.com/cards
# MAX_YESNO_MINIAPP_URL=https://followthefrensy.com/yesno

# --- LLM (трактовки карт) ---
# Основной провайдер: openai | groq
# Если не задан — при наличии OPENAI_API_KEY берётся openai, иначе groq
TAROT_PROVIDER=groq
GROQ_API_KEY=ваш_groq_api_key
GROQ_TAROT_MODEL=llama-3.3-70b-versatile
# GROQ_TAROT_FALLBACK_MODELS=llama-3.1-8b-instant
# GROQ_TAROT_MAX_TOKENS=1100

# Запасной / основной OpenAI (если TAROT_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_TAROT_MODEL=gpt-4o-mini

YOOKASSA_ACCOUNT_ID=ваш_shop_id_из_YooKassa
YOOKASSA_SECRET_KEY=ваш_secret_key_из_YooKassa

# 0 = оплата выкл (реферальный безлимит); 1 = оплата включена
PAYMENTS_ENABLED=0

# Провайдер: robokassa | yookassa
PAYMENT_PROVIDER=robokassa
ROBOKASSA_LOGIN=followthefrensy
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_TEST_PASSWORD1=
ROBOKASSA_TEST_PASSWORD2=
ROBOKASSA_IS_TEST=1
# 1 после одобрения рекуррента в Robokassa (иначе ошибка 34)
ROBOKASSA_RECURRING=0
# После одобрения рекуррента: ROBOKASSA_RECURRING=1 и ROBOKASSA_RECURRING_FORCE=1
# ROBOKASSA_RECURRING_FORCE=0
# Номенклатура 54-ФЗ (Receipt). tax: none | vat20 | vat10 | ...
ROBOKASSA_RECEIPT=1
ROBOKASSA_TAX=none
# ROBOKASSA_SNO=usn_income
# ROBOKASSA_PAYMENT_OBJECT=service
# ROBOKASSA_PAYMENT_METHOD=full_payment
ROBOKASSA_RESULT_URL=https://followthefrensy.ru/robokassa/result
ROBOKASSA_SUCCESS_URL=https://followthefrensy.ru/pay/success
ROBOKASSA_FAIL_URL=https://followthefrensy.ru/pay/fail

# Crypto Pay (@CryptoBot → Crypto Pay → приложение → API Token). Пусто = кнопки крипты нет.
